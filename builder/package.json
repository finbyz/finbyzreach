{
  "name": "builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "build": "yarn typecheck && vite build --base=/assets/finbyzreach/builder/ && yarn copy-html-entry",
    "lint": "oxlint",
    "test": "tsc --noEmit -p tsconfig.test.json && node --test --experimental-transform-types src/lib/*.test.ts",
    "preview": "vite preview",
    "copy-html-entry": "cp ../finbyzreach/public/builder/index.html ../finbyzreach/www/builder.html"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "frappe-react-sdk": "^1.17.0",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
