 "fields": [
  {
   "fieldname": "allowed_embed_origins",
   "fieldtype": "Small Text",
   "label": "Allowed Embed Origins",
   "description": "One website origin per line, for example https://www.example.com. Only these websites may embed the subscription form."
  },
  {
   "fieldname": "translations",
   "fieldtype": "Table",
   "label": "Text Translations",
   "options": "Subscription Center Translation"
  },
  {
   "fieldname": "design_section",
   "fieldtype": "Section Break",
   "label": "Preference center design",
   "collapsible": 1,
   "description": "Edited in Megasol Marketing → Subscriptions & consent → Preference center."
  },
  {
   "fieldname": "draft_config_json",
   "fieldtype": "Code",
   "options": "JSON",
   "label": "Draft design",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "published_config_json",
   "fieldtype": "Code",
   "options": "JSON",
   "label": "Published design",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "published_on",
   "fieldtype": "Datetime",
   "label": "Published on",
   "read_only": 1
  },
  {
   "fieldname": "sending_window_section",
   "fieldtype": "Section Break",
   "label": "Default sending window",
   "description": "Used for new emails and as the starting point for workflows. Times are Europe/Zurich. An end time before the start time means overnight, e.g. 22:00 to 06:00."
  },
  {
   "fieldname": "default_window_enabled",
   "fieldtype": "Check",
   "label": "Restrict sending to a daily window",
   "default": "0"
  },
  {
   "fieldname": "default_window_start",
   "fieldtype": "Time",
   "label": "Window starts",
   "default": "08:00:00",
   "depends_on": "default_window_enabled"
  },
  {
   "fieldname": "default_window_end",
   "fieldtype": "Time",
   "label": "Window ends",
   "default": "17:00:00",
   "depends_on": "default_window_enabled"
  },
  {
   "fieldname": "default_days_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "default_send_monday",
   "fieldtype": "Check",
   "label": "Monday",
   "default": "1",
   "depends_on": "default_window_enabled"
  },
  {
   "fieldname": "default_send_tuesday",
   "fieldtype": "Check",
   "label": "Tuesday",
   "default": "1",
   "depends_on": "default_window_enabled"
  },
  {
   "fieldname": "default_send_wednesday",
   "fieldtype": "Check",
   "label": "Wednesday",
   "default": "1",
   "depends_on": "default_window_enabled"
  },
  {
   "fieldname": "default_send_thursday",
   "fieldtype": "Check",
   "label": "Thursday",
   "default": "1",
   "depends_on": "default_window_enabled"
  },
  {
   "fieldname": "default_send_friday",
   "fieldtype": "Check",
   "label": "Friday",
   "default": "1",
   "depends_on": "default_window_enabled"
  },
  {
   "fieldname": "default_send_saturday",
   "fieldtype": "Check",
   "label": "Saturday",
   "default": "0",
   "depends_on": "default_window_enabled"
  },
  {
   "fieldname": "default_send_sunday",
   "fieldtype": "Check",
   "label": "Sunday",
   "default": "0",
   "depends_on": "default_window_enabled"
  }
